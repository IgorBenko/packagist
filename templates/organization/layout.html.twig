{% extends 'layout.html.twig' %}

{% block title %}{{ organization.displayName }} - {{ parent() }}{% endblock %}

{#
    The navigation holds only the pages this viewer may open (see App\Menu\MenuBuilder), so a column with a
    single entry pointing at the current page is noise: drop it.
#}
{% set orgMenu = knp_menu_get('organization_menu') %}
{% set showOrgNav = orgMenu.children|length > 1 %}

{% block content %}
    <h2 class="title">
        {{ organization.displayName }}
        {# Groundwork for org deletion (not yet implemented). #}
        {% if organization.deleted %}
            <span class="label label-warning">deleted</span>
        {% endif %}
    </h2>

    <section class="row">
        {% if showOrgNav %}
            <div class="col-md-3">
                {{ knp_menu_render(orgMenu, {'currentClass': 'active', 'allow_safe_labels': true}) }}
            </div>
        {% endif %}

        <div class="{{ showOrgNav ? 'col-md-9' : 'col-md-12' }}">
            {% block org_content %}{% endblock %}
        </div>
    </section>
{% endblock %}
