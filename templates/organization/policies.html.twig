{% extends 'organization/layout.html.twig' %}

{% block title %}Policies - {{ organization.displayName }} - {{ parent() }}{% endblock %}

{% block org_content %}
    <h3 class="title">Policies</h3>

    <p class="text-muted">
        Policies raise the security bar for everyone acting on behalf of this organization, owners included.
        A member who no longer satisfies one keeps their membership and teams, but cannot act for the
        organization until they do.
    </p>

    {% if suspendedMemberCount > 0 %}
        <div class="alert alert-warning">
            {{ suspendedMemberCount }} {{ suspendedMemberCount == 1 ? 'member is' : 'members are' }} currently
            suspended for failing a policy. See the
            <a href="{{ path('organization_members', { organization: organization.slug }) }}">members list</a>.
        </div>
    {% endif %}

    {{ form_start(form, { 'attr': { 'class': 'organization_policies' } }) }}
        {{ form_errors(form) }}

        {# Checkbox and its label on one line, as on the profile page's update-failure notifications. #}
        <div class="form-group clearfix">
            {{ form_errors(form.enforceTwoFactor) }}
            <label>
                {{ form_widget(form.enforceTwoFactor) }}
                {{ form.enforceTwoFactor.vars.label }}
            </label>
            {{ form_help(form.enforceTwoFactor) }}
        </div>

        {{ form_row(form.allowedEmailDomains) }}

        <input class="btn btn-success btn-lg" type="submit" value="Save policies" />
    {{ form_end(form) }}
{% endblock %}
