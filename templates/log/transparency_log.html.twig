{% extends "layout.html.twig" %}

{% block title %}
    Packagist - Transparency Log
{% endblock %}

{% block head_additions %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
    <h2 class="title">Transparency Log</h2>

    {% embed 'log/_filters.html.twig' with {route: 'view_transparency_log'} %}
        {% block type_options %}
            {% for type in selectableTypes %}
                <option value="{{ type.value }}" {% if type.value in selectedFilters.type %}selected="selected"{% endif %}>
                    {{ ('log.type.' ~ type.value)|trans }}
                </option>
            {% endfor %}
        {% endblock %}

        {% block fields %}
            <div class="row">
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="vendor-filter">Vendor</label>
                        <input type="text" name="vendor" id="vendor-filter" class="form-control" value="{{ selectedFilters.vendor }}" placeholder="Filter by vendor">
                    </div>
                </div>
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="package-filter">Package Name</label>
                        <input type="text" name="package" id="package-filter" class="form-control" value="{{ selectedFilters.package }}" placeholder="Filter by package name">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="actor-filter">Actor</label>
                        <input type="text" name="actor" id="actor-filter" class="form-control" value="{{ selectedFilters.actor }}" placeholder="Filter by username">
                    </div>
                </div>
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="user-filter">User</label>
                        <input type="text" name="user" id="user-filter" class="form-control" value="{{ selectedFilters.user }}" placeholder="Filter by username">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <small class="help-block">
                    Usernames match the name at the time of the event. Use the account id next to each name to tell accounts apart.
                </small>
            </div>
            {% if selectedFilters.user_id %}
                {# The user_id filter is currently only used when clicking on the Transparency log link on the profile page #}
                <div class="form-group">
                    <small class="help-block">
                        Showing all entries of a single account.
                        <a href="{{ url('view_transparency_log') }}">Show all entries</a>
                    </small>
                    <input type="hidden" name="user_id" value="{{ selectedFilters.user_id }}">
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {% include 'log/_time_range.html.twig' %}

    {% include 'log/_table.html.twig' with {
        displays: transparencyLogDisplays,
        emptyMessage: 'No transparency log entries found.',
    } only %}

    {% if transparencyLogDisplays|length and paginator.haveToPaginate() %}
        {{ pagerfanta(paginator, 'twitter_bootstrap5', {'proximity': 2}) }}
    {% endif %}

    {% if hasMoreEntriesThanPages %}
        <p class="text-muted" data-test="page-limit-note">
            Only the first {{ maxPages }} pages are shown. To see older entries, narrow the results with the filters above, for example by package, vendor, user or time range.
        </p>
    {% endif %}
{% endblock %}
